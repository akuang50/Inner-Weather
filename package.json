{
  "name": "inner-weather",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "EXPO_NO_TYPED_ROUTES=1 BROWSER=none expo start --web --localhost",
    "web:open": "EXPO_NO_TYPED_ROUTES=1 expo start --web --localhost",
    "site": "npm --prefix site run dev -- --host 127.0.0.1 --port 5173",
    "coach": "cd server && uvicorn chatbot:app --reload --host 127.0.0.1 --port 8000",
    "export:web": "EXPO_NO_TYPED_ROUTES=1 expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.24",
    "expo-av": "^16.0.8",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "^6.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "typescript": "~5.9.2"
  },
  "private": true
}
